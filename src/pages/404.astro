---
import Layout from "@/layouts/Layout.astro"
---

<Layout title="Página no encontrada | Joseline Franco" description="La página que buscas no existe.">
  <main class="flex flex-col items-center justify-center min-h-[70vh] gap-6 px-4 pt-24 text-center">
    <p class="text-7xl font-bold text-yellow-400">404</p>
    <h1 class="text-2xl font-semibold text-white">Esta página no existe</h1>
    <a href="/" class="px-6 py-3 font-semibold text-black rounded-full bg-yellow-400 hover:bg-yellow-300">Volver al inicio</a>
  </main>
</Layout>
