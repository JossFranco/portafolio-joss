---
import type { GetStaticPaths } from "astro"
import { Image } from "astro:assets"
import Layout from "@/layouts/Layout.astro"
import LinkInline from "@/components/ui/LinkInline.astro"
import { PROJECTS } from "@/data/projects"
import type { Project } from "@/types"

export const getStaticPaths = (() =>
  PROJECTS.map((project) => ({ params: { slug: project.slug }, props: { project } }))) satisfies GetStaticPaths

interface Props {
  project: Project
}

const { project } = Astro.props
---

<Layout title={`${project.title} | Joseline Franco`} description={project.summary}>
  <main class="px-4 pt-32 mx-auto container lg:max-w-4xl md:max-w-2xl">
    <a href="/#proyectos" class="text-sm text-gray-400 hover:text-yellow-300">&larr; Volver a proyectos</a>
    <h1 class="mt-4 text-4xl font-bold text-white">{project.title}</h1>
    <ul class="flex flex-wrap gap-2 mt-4">
      {project.tags.map((tag) => (
        <li class="px-2 py-1 text-xs rounded-full bg-yellow-500/10 text-yellow-200">{tag}</li>
      ))}
    </ul>
    {project.image && (
      <Image src={project.image} alt={project.title} class="w-full mt-8 rounded-xl" />
    )}
    <p class="mt-8 text-lg text-gray-300 text-pretty">{project.description}</p>
    <div class="flex gap-6 mt-8">
      {project.demo && <LinkInline href={project.demo}>Ver demo</LinkInline>}
      {project.repo && <LinkInline href={project.repo}>Ver código</LinkInline>}
    </div>
  </main>
</Layout>
