---
import { Image } from "astro:assets"
import LinkInline from "@/components/ui/LinkInline.astro"
import type { Experience } from "@/types"
import { formatMonthYear } from "@/utils/date"

type Props = Experience

const { company, logo, position, startDate, endDate, location, highlights, link } = Astro.props
---

<div
  class="relative mx-12 pb-12 grid before:absolute before:left-[-35px] before:block before:h-full before:border-l-2 before:border-white/15 before:content-[''] md:grid-cols-5 md:gap-10 md:space-x-4"
>
  <div class="relative pb-6 md:pb-12 md:col-span-2">
    <div class="sticky top-24">
      <span class="text-yellow-400 -left-[42px] absolute rounded-full text-5xl leading-none" aria-hidden="true">&bull;</span>

      <div class="flex items-center gap-3">
        {logo && (
          <Image
            src={logo}
            alt={`Logo de ${company}`}
            width={40}
            height={40}
            class="w-10 h-10 object-contain rounded-md border border-gray-600"
          />
        )}
        <div>
          <h3 class="text-xl font-bold text-yellow-400">{position}</h3>
          <h4 class="font-semibold text-lg text-white">{company}</h4>
          <time datetime={startDate.toISOString()} class="block text-sm first-letter:uppercase text-white/80">
            {formatMonthYear(startDate)} – {endDate ? formatMonthYear(endDate) : "Presente"}
          </time>
          {location && <span class="block text-sm text-white/60">{location}</span>}
        </div>
      </div>
    </div>
  </div>

  <div class="relative flex flex-col gap-2 pb-4 text-gray-300 md:col-span-3">
    <ul class="flex flex-col gap-2 pl-5 list-disc marker:text-yellow-400">
      {highlights.map((highlight) => <li>{highlight}</li>)}
    </ul>
    {link && (
      <LinkInline href={link}>
        Saber más
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M9 6l6 6l-6 6" />
        </svg>
      </LinkInline>
    )}
  </div>
</div>
