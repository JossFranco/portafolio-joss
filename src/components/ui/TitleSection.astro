---
const ICONS = {
  briefcase: ["M3 9a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z", "M8 7v-2a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v2", "M12 12v.01", "M3 13a20 20 0 0 0 18 0"],
  code: ["M7 8l-4 4l4 4", "M17 8l4 4l-4 4", "M14 4l-4 16"],
  tools: ["M3 21h4l13 -13a1.5 1.5 0 0 0 -4 -4l-13 13v4", "M14.5 5.5l4 4"],
  school: ["M22 9l-10 -4l-10 4l10 4l10 -4v6", "M6 10.6v5.4a6 3 0 0 0 12 0v-5.4"],
  user: ["M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0", "M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"],
  mail: ["M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z", "M3 7l9 6l9 -6"],
}

interface Props {
  title: string
  icon?: keyof typeof ICONS
}

const { title, icon } = Astro.props
---

<div class="flex items-center gap-3 mb-6">
  {icon && (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="size-8 text-yellow-400"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      {ICONS[icon].map((d) => <path d={d} />)}
    </svg>
  )}
  <h2 class="text-3xl font-bold text-white tracking-tight">
    {title}
  </h2>
</div>
