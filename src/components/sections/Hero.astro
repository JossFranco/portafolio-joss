---
import { Image } from "astro:assets"
import Badge from "@/components/ui/Badge.astro"
import SocialPill from "@/components/ui/SocialPill.astro"
import { SITE } from "@/data/site"
import githubIcon from "@/assets/github_dark.svg"
import linkedinIcon from "@/assets/linkedin.svg"
import gmailIcon from "@/assets/gmail.svg"

const SOCIALS = [
  { href: SITE.github, label: "GitHub", variant: "github", icon: githubIcon },
  { href: SITE.linkedin, label: "LinkedIn", variant: "linkedin", icon: linkedinIcon },
  { href: `mailto:${SITE.email}`, label: "Correo electrónico", variant: "mail", icon: gmailIcon },
] as const
---

<h1 class="text-white text-5xl font-bold flex flex-row gap-x-4 gap-y-4 pb-10 flex-wrap justify-center items-center">
  Hey, soy Joseline
  <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" class="flex justify-center items-center">
    <Badge>Disponible para trabajar</Badge>
  </a>
</h1>

<p
  class="max-w-3xl mx-auto mt-6 text-center text-xl text-gray-300 [&>strong]:text-yellow-200 [&>strong]:font-semibold"
>
  <strong>Front-End Developer</strong> con más de 3 años de experiencia en
  <strong>Angular</strong> y <strong>TypeScript</strong>, especializada en migraciones
  de aplicaciones legacy (<strong>AngularJS a Angular moderno</strong>), diseño
  responsivo y validación de <strong>APIs REST</strong>. Experiencia en el sector
  financiero y fintech bajo <strong>Scrum</strong>, aplicando
  <strong>Clean Code</strong> y <strong>SOLID</strong>. Residente en Quito 🇪🇨,
  disponible para proyectos <strong>remotos o híbridos</strong>.
</p>

<div class="flex justify-center items-center gap-6 mt-8">
  {SOCIALS.map(({ href, label, variant, icon }) => (
    <SocialPill href={href} label={label} variant={variant}>
      <Image src={icon} alt="" class="size-8 transition-transform duration-200 group-hover:scale-110" />
    </SocialPill>
  ))}
</div>
