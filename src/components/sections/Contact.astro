---
import TitleSection from "@/components/ui/TitleSection.astro"
import { SITE } from "@/data/site"
---

<TitleSection title="Contacto" icon="mail" />

<div class="flex flex-col items-start gap-4 text-gray-300">
  <p>¿Tienes un proyecto o una oportunidad laboral? Escríbeme y conversemos.</p>
  <a
    href={`mailto:${SITE.email}`}
    class="px-6 py-3 font-semibold text-black rounded-full bg-yellow-400 transition hover:bg-yellow-300"
  >
    {SITE.email}
  </a>
</div>
