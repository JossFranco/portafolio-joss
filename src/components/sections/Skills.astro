---
import TitleSection from "@/components/ui/TitleSection.astro"
import { SKILLS } from "@/data/skills"
---

<TitleSection title="Habilidades" icon="tools" />

<div class="grid gap-6 sm:grid-cols-2">
  {SKILLS.map(({ category, items }) => (
    <div class="p-6 rounded-xl border border-white/10 bg-white/5">
      <h3 class="mb-3 font-semibold text-yellow-400">{category}</h3>
      <ul class="flex flex-wrap gap-2">
        {items.map((skill) => (
          <li class="px-3 py-1 text-sm rounded-full bg-gray-800 text-gray-200">{skill}</li>
        ))}
      </ul>
    </div>
  ))}
</div>
