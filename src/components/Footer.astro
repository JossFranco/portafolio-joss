---
import { SITE } from "@/data/site"

const currentYear = new Date().getFullYear()
---

<footer class="w-full px-4 mx-auto mt-16 mb-10 opacity-80 container lg:max-w-4xl md:max-w-2xl">
  <div class="flex flex-col gap-3 py-4 md:flex-row md:items-center md:justify-between">
    <span class="text-sm text-zinc-200/90">&copy; {currentYear} {SITE.name}. Casi todos los derechos reservados.</span>
    <ul class="flex flex-wrap items-center gap-4 text-sm font-medium text-white/90 md:gap-6">
      <li><a href="/#sobre-mi" class="hover:underline">Sobre mí</a></li>
      <li><a href={`mailto:${SITE.email}`} class="hover:underline">Contacto</a></li>
    </ul>
  </div>
</footer>
